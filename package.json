{
  "name": "miri-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "start:lan": "expo start --lan",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:dev-ios": "eas build --profile development-device --platform ios",
    "build:preview-ios": "eas build --profile preview --platform ios",
    "deploy:web": "npx expo export --platform web && echo '{\"rewrites\":[{\"source\":\"/(.*)\",\"destination\":\"/index.html\"}]}' > dist/vercel.json && cd dist && npx vercel deploy --prod --yes"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@supabase/supabase-js": "^2.99.1",
    "expo": "~55.0.6",
    "expo-apple-authentication": "~55.0.8",
    "expo-auth-session": "~55.0.8",
    "expo-camera": "~55.0.9",
    "expo-clipboard": "~55.0.8",
    "expo-constants": "~55.0.7",
    "expo-crypto": "~55.0.9",
    "expo-dev-client": "~55.0.16",
    "expo-file-system": "~55.0.10",
    "expo-image-manipulator": "~55.0.10",
    "expo-image-picker": "~55.0.12",
    "expo-linking": "~55.0.7",
    "expo-localization": "~55.0.8",
    "expo-notifications": "~55.0.12",
    "expo-router": "~55.0.5",
    "expo-secure-store": "~55.0.8",
    "expo-sharing": "~55.0.11",
    "expo-status-bar": "~55.0.4",
    "expo-web-browser": "~55.0.9",
    "html-to-image": "^1.11.13",
    "i18next": "^25.8.18",
    "korean-lunar-calendar": "^0.3.6",
    "react": "19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.8",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-gifted-charts": "^1.4.76",
    "react-native-iap": "^14.7.17",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.19.13",
    "react-native-worklets": "^0.7.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2"
  },
  "private": true
}
