{
  "expo": {
    "name": "명리",
    "slug": "myeongri-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "myeongri",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FEFCF8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.myeongri.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "관상 분석을 위해 카메라 접근이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "관상 분석을 위해 사진 접근이 필요합니다."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8B04A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "package": "com.myeongri.app",
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-localization",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "관상 분석을 위해 카메라 접근이 필요합니다."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}
